package com.orderApi.service;

import java.text.SimpleDateFormat;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import java.util.UUID;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.orderApi.dto.AddressDto;
import com.orderApi.dto.CustomerDto;
import com.orderApi.dto.OrderDto;
import com.orderApi.dto.OrderItemDto;
import com.orderApi.dto.PaymentCallBackDto;
import com.orderApi.entity.Address;
import com.orderApi.entity.Customer;
import com.orderApi.entity.Order;
import com.orderApi.entity.OrderItem;
import com.orderApi.repo.AddressRepo;
import com.orderApi.repo.CustomerRepo;
import com.orderApi.repo.OrderItemRepo;
import com.orderApi.repo.OrderRepo;
import com.orderApi.reponse.PurchaseOrderResponse;
import com.orderApi.request.PurchaseOrderRequest;
@Service
public class OrderServiceImpl implements OrderService {
	@Autowired
	private OrderRepo orderRepo;
	@Autowired
	private CustomerRepo customerRepo;
	@Autowired
	private OrderItemRepo orderItemRepo;
	@Autowired
	private AddressRepo addressRepo;
	@Autowired
	private RazorpayService razorpayService;

	@Override
	public PurchaseOrderResponse createOrder(PurchaseOrderRequest orderRequest) {
		CustomerDto customer = orderRequest.getCustomer();
		AddressDto address = orderRequest.getAddress();
		OrderDto order = orderRequest.getOrder();
		List<OrderItemDto> orderItems =orderRequest.getOrderItems();
		
		Customer c = customerRepo.findByEmail(customer.getEmail());
		if(c == null) {
			c = new Customer();
			c.setEmail(customer.getEmail());
			c.setName(customer.getName());
			c.setPhoneNo(customer.getPhoneNo());
			customerRepo.save(c);
		}
		
		Address addr = new Address();
		addr.setHouseNum(address.getHouseNum());
		addr.setCity(address.getCity());
		addr.setState(address.getState());
		addr.setZipCode(address.getZipCode());
		addr.setCustomer(c);
		addressRepo.save(addr);
		
		Order or = new Order();
		String orderTrackingNumber = generateOrderTrackingNumber();
		or.setOrderTrackingNumber(orderTrackingNumber);
		com.razorpay.Order paymentOrder = razorpayService.createRazorpayOrder(order.getTotalPrice());
		or.setRazorpayOrderId(paymentOrder.get("id"));
		or.setOrderStatus(paymentOrder.get("status"));
		or.setTotalPrice(order.getTotalPrice());
		or.setTotalQuantity(order.getTotalQuantity());
		or.setEmail(c.getEmail());
		or.setCustomer(c);
		or.setAddress(addr);
		orderRepo.save(or);
		
		for(OrderItemDto orderItem: orderItems) {
			OrderItem orderIt = new OrderItem();
			BeanUtils.copyProperties(orderItem, orderIt);
			orderIt.setOrder(or);
			orderItemRepo.save(orderIt);
		}
		return PurchaseOrderResponse.builder()
									.razorpayOrderId(paymentOrder.get("id"))
									.orderStatus(paymentOrder.get("status"))
									.ordertrackingNumber(orderTrackingNumber)
									.build();
	}

	private String generateOrderTrackingNumber() {
		SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMddHHmmss");
		String timeFormat = sdf.format(new Date());
		String randomUuid = UUID.randomUUID().toString().substring(0, 5).toUpperCase();
		
		return "OD" + timeFormat + randomUuid;
	}

	@Override
	public PurchaseOrderResponse updateOrder(PaymentCallBackDto paymentCallBackDto) {
		
		Order order= orderRepo.findByRazorpayOrderId(paymentCallBackDto.getRazorpayOrderId());
		if(order != null) {
			order.setOrderStatus("CONFIRMED");
			order.setDeliveryDate(LocalDate.now().plusDays(3));
			order.setRazorpayPaymentId(paymentCallBackDto.getRaorpayPaymentId());
			orderRepo.save(order);
		}
		return PurchaseOrderResponse.builder()
									.orderStatus(order.getOrderStatus())
									.ordertrackingNumber(order.getOrderTrackingNumber())
									.razorpayOrderId(order.getRazorpayOrderId())
									.build();
	}

	@Override
	public List<OrderDto> getOrdersByEmail(String email) {
		List<OrderDto> ordersList = new ArrayList<>();
		List<Order> order = orderRepo.findByEmail(email);
		for(Order or: order) {
			OrderDto dto = new OrderDto();
			BeanUtils.copyProperties(or, dto);
			ordersList.add(dto);
		}
		return ordersList;
	}

}
