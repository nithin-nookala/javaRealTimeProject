			c = new Customer;
			c.setEmail(customer.getEmail());
			c.setName(customer.getName());
			c.setPhoneNo(customer.getPhoneNo());
			customerRepo.save(c);
		}
		
		Address addr = new Address();
		addr.setHouseNum(address.getHouseNum());
		addr.setCity(address.getCity());
		addr.setState(address.getState());
		addr.setZipCode(address.getZipCode());
		addr.setCustomer(c);
		addressRepo.save(addr);
		
		Order o = new Order();
		String orderTrackingNumber = generateOrderTrackingNumber();
		o.setOrderTrackingNumber(orderTrackingNumber);
		com.razorpay.Order paymentOrder = razorpayService.createRazorpayOrder(order.getTotalPrice());
		o.setRazorpayOrderId(paymentOrder.get("id"));
		o.setOrderStatus(paymentOrder.get("status"));
		o.setTotalPrice(order.getTotalPrice());
		o.setTotalQuantity(order.getTotalQuantity());
		o.setEmail(c.getEmail());
		o.setCustomer(c);
		o.setAddress(addr);
		return null;
	}

